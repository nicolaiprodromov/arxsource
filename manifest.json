{
  "manifest_version": "0.3",
  "name": "arxsource-mcp",
  "display_name": "ArxSource",
  "version": "0.1.0",
  "description": "Read the paper. Find the source. Search, read and analyze arXiv papers, and find their code.",
  "author": {
    "name": "nicolaiprodromov",
    "email": "57862822+nicolaiprodromov@users.noreply.github.com",
    "url": "https://github.com/nicolaiprodromov"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nicolaiprodromov/arxsource.git"
  },
  "homepage": "https://github.com/nicolaiprodromov/arxsource",
  "documentation": "https://github.com/nicolaiprodromov/arxsource#readme",
  "support": "https://github.com/nicolaiprodromov/arxsource/issues",
  "icon": "icon.png",
  "server": {
    "type": "python",
    "entry_point": "server/arxsource_mcp/__main__.py",
    "mcp_config": {
      "command": "python3.11",
      "args": [
        "-m",
        "arxsource_mcp",
        "--storage-path",
        "${user_config.storage_path}"
      ],
      "env": {
        "PYTHONPATH": "${__dirname}/server:${__dirname}/server/vendor"
      }
    }
  },
  "keywords": [
    "arxiv",
    "research",
    "papers",
    "latex",
    "citation-graphs",
    "github",
    "huggingface",
    "semantic-search",
    "mcp"
  ],
  "license": "Apache-2.0",
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": ["darwin"],
    "runtimes": {
      "python": ">=3.11,<3.12"
    }
  },
  "user_config": {
    "storage_path": {
      "type": "directory",
      "title": "Paper Storage Directory",
      "description": "Local directory for storing downloaded arXiv papers.",
      "required": false,
      "default": "${HOME}/.arxsource/papers"
    }
  }
}
